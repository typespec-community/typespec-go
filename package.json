{
  "name": "@typespec-community/typespec-go",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "alloy build && node scripts/prune-dist.mjs",
    "build:check": "tsc --noEmit --strict",
    "test": "vitest",
    "test:typespec": "vitest --run --testTimeout 30000",
    "lint": "eslint src/ --ext .ts --max-warnings 0",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "test:e2e-cli": "node scripts/test-e2e-cli.mjs",
    "format:check": "dprint check",
    "test:coverage": "vitest --run --coverage.enabled --testTimeout 30000"
  },
  "dependencies": {
    "@alloy-js/core": "^0.22.0",
    "@alloy-js/go": "^0.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typespec/compiler": "^1.18.0",
    "@typespec/emitter-framework": "^0.17.0",
    "@typespec/http": "^1.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alloy-js/cli": "^0.22.0",
    "@alloy-js/rollup-plugin": "^0.1.0",
    "@alloy-js/typescript": "^0.22.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "4.1.12",
    "dprint": "^0.64.3",
    "eslint": "^10.14.0",
    "typescript": "6.0.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.18.0"
  },
  "overrides": {
    "nanoid": "3.3.20",
    "vite": "7.3.8",
    "@babel/core": "7.29.13",
    "source-map-js": "^1.2.2",
    "picomatch": "^4.0.7",
    "yaml": "^2.8.3",
    "fast-uri": "^3.1.9",
    "postcss": "^8.5.12",
    "browserslist": "^4.28.7",
    "rollup": "^4.68.3"
  },
  "tspMain": "lib/main.tsp",
  "files": [
    "dist",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "docs/MAPPING-GUIDE.md"
  ]
}
